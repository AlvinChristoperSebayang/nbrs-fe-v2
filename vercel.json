{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bulkRedirectsPath": "redirects",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://staging.cms.nbrs.com.au https://new.cms.nbrs.com.au"
        }
      ]
    }
  ]
}
